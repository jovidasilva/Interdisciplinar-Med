# Copie este arquivo para ".env" e ajuste os valores conforme seu ambiente.
# Se estiver usando o docker-compose.yml incluso, os valores padrão já funcionam.

DB_HOST=db
DB_USER=root
DB_PASS=root
DB_NAME=proj_internato
DB_PORT=3306
# Deixe vazio se a aplicação estiver servida na raiz do domínio (ex: Docker,
# http://localhost:8080/). Só preencha (ex: /Interdisciplinar-Med) se estiver
# servida dentro de um subdiretório do domínio.
BASE_URL=

# Configuração de SMTP usada pelo fluxo de "esqueci minha senha"
# (includes/mailer.php). Os valores padrão já funcionam com o serviço
# "mailpit" incluso no docker-compose.yml (interface web em
# http://localhost:8025 para visualizar os e-mails enviados em desenvolvimento).
SMTP_HOST=mailpit
SMTP_PORT=1025
# Deixe em branco se o servidor SMTP não exigir autenticação (ex: Mailpit).
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@intermed.local
# Deixe em branco para nenhuma criptografia (ex: Mailpit). Use "tls" ou "ssl"
# para servidores SMTP reais que exigem criptografia.
SMTP_SECURE=
